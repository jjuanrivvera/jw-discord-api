{
  "name": "jw-discord-api",
  "version": "2.0.0",
  "description": "REST API for JW Discord Bot management dashboard",
  "main": "index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "lint": "eslint src/**/*.js tests/**/*.js --fix",
    "lint:check": "eslint src/**/*.js tests/**/*.js",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jjuanrivvera99/jw-discord-api.git"
  },
  "keywords": [
    "discord",
    "api",
    "jw",
    "express"
  ],
  "author": "jjuanrivvera99",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jjuanrivvera99/jw-discord-api/issues"
  },
  "homepage": "https://github.com/jjuanrivvera99/jw-discord-api#readme",
  "dependencies": {
    "@sentry/node": "^7.100.0",
    "awilix": "^10.0.1",
    "axios": "^1.6.7",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "discord-oauth2": "^2.11.0",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "memory-cache": "^0.2.0",
    "mongoose": "^8.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "husky": "^9.0.10",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "lint-staged": "^15.2.0",
    "mongodb-memory-server": "^9.1.6",
    "nodemon": "^3.0.3",
    "supertest": "^6.3.4"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ]
  }
}
